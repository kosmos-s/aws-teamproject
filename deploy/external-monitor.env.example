# Install on a DIFFERENT always-on host, not the monitored EC2.
MONITOR_URL=https://portal.example.com/health
# Set a newly approved operating window before enabling the timer.
MONITOR_START_AT=2099-01-01T00:00:00+00:00
MONITOR_STOP_AT=2099-01-02T00:00:00+00:00
# Blank SMTP_HOST means no email is sent; delivery remains unconfigured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
